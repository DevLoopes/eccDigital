# App ports
    WEB_PORT=3000
PORT_DOCS=3001
API_PORT=3333

# ── Database connection ── 
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sifr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha
POSTGRES_ENCRYPT=true

# Exemplo (substitua user/pass/host/port/dbname)
# `@` na senha precisa ser percent-encoded em URLs do PostgreSQL
DATABASE_URL=postgresql://postgres:%40senha@localhost:5432/sifr_db

URL_FRONTEND=http://localhost:5374