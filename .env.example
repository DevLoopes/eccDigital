# App ports
PORT_WEB=3000
PORT_DOCS=3001
PORT_API=3333

# ── Database connection ── 
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sifr_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha
POSTGRES_ENCRYPT=true

# Exemplo (substitua user/pass/host/port/dbname)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/sifr_db
# ou
DB_URL=postgresql://postgres:senha@localhost:5432/sifr_db

URL_FRONTEND=http://localhost:5374